rules_version = '2';
// DL FINANZAS · Reglas de seguridad de Firestore
// Cada usuario solo puede leer y escribir sus propios datos.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validTx() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'flow', 'frequency', 'concept', 'amount', 'category', 'date'])
        && d.flow in ['ingreso', 'fijo', 'variable']
        && d.frequency in ['mensual', 'quincenal', 'factura']
        && d.amount is number && d.amount >= 0 && d.amount < 1000000000000
        && d.concept is string && d.concept.size() <= 80
        && d.category is string && d.category.size() <= 60
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'idNumber', 'limits', 'currency', 'legalVersion', 'legalAcceptedAt', 'createdAt', 'updatedAt', 'customCategories'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('currency' in d) || (d.currency is string && d.currency.size() <= 5))
        && (!('limits' in d) || d.limits is map);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser();

      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTx() && request.resource.data.id == txId;
      }
    }
  }
}
